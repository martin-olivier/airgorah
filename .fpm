-s dir ./target/debug/airgorah ./target/debug/airgorah-agent ./crates/gui/icons/app_icon.png package README.md LICENSE
--name airgorah
--license MIT
--version 0.8.1
--description "A WiFi security auditing software mainly based on aircrack-ng tools suite"
--url "https://github.com/martin-olivier/airgorah"
--maintainer "Martin Olivier <martin.olivier@live.fr>"

--provides airgorah
--conflicts airgorah

--depends bash
--depends xterm
--depends iw
--depends macchanger
--depends aircrack-ng
--depends adwaita-icon-theme

target/debug/airgorah=/usr/bin/airgorah
target/debug/airgorah-agent=/usr/bin/airgorah-agent
crates/gui/icons/app_icon.png=/usr/share/pixmaps/airgorah.png

package/.desktop=/usr/share/applications/com.molivier.airgorah.desktop
package/.policy=/usr/share/polkit-1/actions/org.freedesktop.policykit.airgorah.policy

README.md=/usr/share/doc/airgorah/README.md
LICENSE=/usr/share/doc/airgorah/LICENSE